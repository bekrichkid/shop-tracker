DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=4100

# Ixtiyoriy: JWT uchun maxfiy kalit (bo'lmasa DATABASE_URL'dan hosil qilinadi)
JWT_SECRET=
# Sayt manzili (to'lovdan qaytish uchun)
APP_URL=https://bekrichkid-shop-tracker.netlify.app
# 1 USD necha so'm (buyurtma summasi so'mda)
USD_TO_UZS=12500
# Payme (Merchant API). Bo'sh bo'lsa Demo to'lov ishlaydi.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=off
# Demo to'lovni majburan yoqish/o'chirish: on | off
PAYMENT_DEMO=

# Katalogni boshqarish huquqi (vergul bilan ajratilgan emaillar)
ADMIN_EMAILS=
