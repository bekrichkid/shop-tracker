DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=4100

# Ixtiyoriy: JWT uchun maxfiy kalit (bo'lmasa DATABASE_URL'dan hosil qilinadi)
JWT_SECRET=
# Sayt manzili (to'lovdan qaytish uchun)
APP_URL=https://bekrichkid-shop-tracker.netlify.app
# 1 USD necha so'm (buyurtma summasi so'mda)
USD_TO_UZS=12500
# Payme (Merchant API). Bo'sh bo'lsa Demo to'lov ishlaydi.
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=off
# Demo to'lovni majburan yoqish/o'chirish: on | off
PAYMENT_DEMO=

# Katalogni boshqarish huquqi (vergul bilan ajratilgan emaillar)
ADMIN_EMAILS=

# Yangi to'langan buyurtma haqida Telegram xabari (BotFather'dan token, chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Mijozlarga ko'rinadigan aloqa ma'lumotlari
STORE_NAME=Tovar Do'koni
SUPPORT_PHONE=
SUPPORT_TELEGRAM=
SUPPORT_HOURS=09:00–21:00

# Click (SHOP-API). Uchalasi qo'yilsa Click to'lovi yoqiladi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Email (Resend.com): parolni tiklash havolasi va buyurtma xabarlari. Bo'sh bo'lsa email yuborilmaydi.
RESEND_API_KEY=
MAIL_FROM="Tovar Do'koni <noreply@sizning-domen.uz>"
